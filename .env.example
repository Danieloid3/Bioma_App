# Entorno
APP_ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5174

# Puertos locales
REDIS_PORT=63799
DB_PORT=55432
API_PORT=8001
WEB_PORT=5174

# Base de datos PostgreSQL
POSTGRES_DB=bioma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
BIO_APP_DB_USER=bio_app_user
BIO_APP_DB_PASSWORD=bio_app_dev_password_change_me

# JWT y Seguridad
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_bioma
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=bioma_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_COPILOT=30

# IA & LLM
OPENAI_API_KEY=
BIO_LLM_PROVIDER=openai
BIO_LLM_MODEL=gpt-5.6-terra
BIO_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_WORKER_POLL_SECONDS=5

# Frontend
VITE_API_BASE_URL=http://localhost:8001
